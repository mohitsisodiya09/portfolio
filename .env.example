# Canonical production URL for Open Graph tags and metadata.
# Optional on Vercel — if empty, build uses https://$VERCEL_URL automatically.
# Set explicitly after deploy for a custom domain, e.g.:
#   https://your-project.vercel.app
#   https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Formspree form ID only — not the full URL.
# Example: https://formspree.io/f/xyzabc123 → set xyzabc123
# Also allow your production domain in the Formspree form settings.
NEXT_PUBLIC_FORMSPREE_FORM_ID=
